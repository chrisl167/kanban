# 后端监听地址与端口
PORT=3100
HOST=127.0.0.1

# SQLite 数据库目录，建议放在 iStoreOS 持久化插件目录
KANBAN_DATA_DIR=/opt/kanban/data

# 前端静态文件目录；长期部署时指向上传后的 dist 目录
DIST_DIR=/opt/kanban/app/dist

# 生产环境必须改成随机长字符串；可用 `openssl rand -hex 32` 生成
JWT_SECRET=change-me-to-a-long-random-secret
JWT_TTL=7d

# 是否开放注册。首个账号创建完成后建议改为 false
ALLOW_REGISTRATION=false
